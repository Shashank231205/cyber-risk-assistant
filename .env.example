# ===========================================================================
# Cyber Risk Assistant -- environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be
# committed. Every value below has a safe default: the system runs and
# produces a full ranked risk report with NO keys configured at all.
# API keys only enable the natural-language narrative layer.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM provider chain ----------------------------------------------------
# Tried in order; first configured & healthy provider wins. If all fail the
# system falls back to deterministic template narration (no LLM required).
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# Google AI Studio -- free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq -- free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter -- free-tier models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- Embeddings ------------------------------------------------------------
# local  = fastembed / ONNX, no key, no network, runs in ~150 MB RAM
# gemini = Google embedding API (needs GEMINI_API_KEY)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# --- Vector store ----------------------------------------------------------
# faiss = exact flat index (default); numpy = dependency-free fallback
VECTOR_BACKEND=faiss
VECTOR_INDEX_PATH=data/processed/nist_index
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.30

# --- Data paths ------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_REFERENCE_DIR=data/reference
DATA_OUTPUT_DIR=data/outputs

# --- Reference corpora (pinned snapshots, fetched by scripts/) -------------
KEV_SOURCE_URL=https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.csv
NIST_SOURCE_URL=https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json

# --- Risk scoring ----------------------------------------------------------
# Factor weights, derived from the MDR advisory's stated analyst priority
# order. Tunable without code changes.
RISK_TOP_N=5
WEIGHT_INTERNET_EXPOSURE=25
WEIGHT_ACTIVE_EXPLOITATION=22
WEIGHT_RANSOMWARE_ASSOCIATION=18
WEIGHT_BUSINESS_CRITICALITY=20
WEIGHT_MISSING_CONTROLS=15

# --- Security --------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
CORS_ALLOWED_ORIGINS=*
# Optional: gate the public demo behind a shared token. Leave blank for open access.
DEMO_ACCESS_TOKEN=
