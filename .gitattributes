# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf

*.png   binary
*.jpg   binary
*.pdf   binary
*.onnx  binary
